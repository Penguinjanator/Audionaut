# Audio files the test suite writes at runtime - regenerated on every run,
# never fixtures. Listed by exact name so checked-in fixtures (sine-0dB.wav,
# noise0dB.wav, the session's own audio, ...) can never be caught by accident.
TestFiles/slow-saw.wav
TestFiles/slow-saw-2-seconds.wav
TestFiles/slow-saw-out.wav
TestFiles/stereo-saw.wav
TestFiles/dc-offset.wav
TestFiles/dc-offset-b.wav
TestFiles/ramp-gen.wav
